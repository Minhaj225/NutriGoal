  "version": "2.0.0",
  "description": "NutriGoal meal, profile, feedback, and recommendation API",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vercel-build": "echo 'Backend build complete'",
