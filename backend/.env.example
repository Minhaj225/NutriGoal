# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGO_URI=mongodb://localhost:27017/meal-recommender

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# ML API Configuration
ML_API_URL=http://localhost:5000
# Use the same random secret on Node and Flask; never use a VITE_ variable.
ML_API_TOKEN=
# Set only after a behavioral artifact has passed its release gate.
# ML_MODEL_VERSION=
# Baseline ranking is active until a behavioral model passes the release gate.
RECOMMENDER_MODE=baseline

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to true for one run to rotate an existing admin's password
# ADMIN_ROTATE_PASSWORD=true

# Redis Configuration (required for shared rate limiting on Vercel/Production)
# Upstash Redis (recommended for Vercel deployment)
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: Email Configuration (for notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
